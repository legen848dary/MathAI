# MathAI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Required: your Google Gemini API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Novita AI API key (for deepseek-v4-flash etc.)
# Get one at https://novita.ai
# NOVITA_API_KEY=your_novita_api_key_here

# Optional: override Novita model (default: deepseek/deepseek-v4-flash)
# NOVITA_MODEL=deepseek/deepseek-v4-flash

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL password (default: mathai_secret)
# DB_PASSWORD=mathai_secret

# ── Admin Portal ──────────────────────────────────────────────────────────────
# Initial admin credentials (set these before first deploy)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your_secure_admin_password

# JWT signing secret (change in production!)
# JWT_SECRET=your-long-random-secret-string
